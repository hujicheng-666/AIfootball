# ============================================================
#  AIfootball .gitignore
#  原则：源码 / 文档 / 建模资产 / 运行环境（python_env）入库；
#        构建产物、编辑器缓存、运行期数据不入库。
#        大二进制由 Git LFS 管理（见 .gitattributes）。
# ============================================================

# --- .NET 编译产物（可重新编译产生，不入库）---
[Bb]in/
[Oo]bj/
*.user
*.suo
*.sln.docstates
.vs/

# --- Unity 构建产物与编辑器缓存（可重新生成，不入库）---
/_build_demo/
/runtime/
/Myproject/Library/
/Myproject/Temp/
/Myproject/Logs/
/Myproject/UserSettings/
/Myproject/Builds/
/Myproject/obj/
/Myproject/data/
/Myproject/.tmp_synth/
/Myproject/.agents/
*.unitypackage

# --- Python 字节码缓存（解释器本体入库，缓存不入库）---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/

# --- 前端依赖与构建输出 ---
src/AIfootball.Web/node_modules/
src/AIfootball.Web/dist/
src/AIfootball.Web/.vite/

# --- 运行期数据与本地输出 ---
/data/
/logs/
/calib/
/output/*
!/output/blender/
/output/blender/*.blend1
/output/blender/preview*/

# --- 打包/发布产物 ---
dist/
*.msix
*.msixbundle
.build-check/

# --- AI 工具工作目录（会话记录、记忆、缓存，不入库）---
/.workbuddy/
/.codebuddy/

# --- 临时/系统文件 ---
.tmp_*
*.tmp
*.log
Thumbs.db
Desktop.ini
.DS_Store
