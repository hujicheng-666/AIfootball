# ============================================================
#  AIfootball .gitignore
#  原则：源码 / 文档 / 建模资产 / 运行环境（python_env）入库；
#        构建产物、编辑器缓存、运行期数据不入库。
#        大二进制由 Git LFS 管理（见 .gitattributes）。
# ============================================================

# --- .NET 编译产物（按工程目录限定）---
# 注意不要写成全局 [Bb]in/：python_env 里的第三方包自带的 bin/ 目录
# （如 decompyle3/bin/）是运行时代码，误忽略会导致依赖残缺。
/src/**/bin/
/src/**/obj/
/tests/**/bin/
/tests/**/obj/
/tools/**/bin/
/tools/**/obj/
/mobile-camera-bridge/**/bin/
/mobile-camera-bridge/**/obj/
/bin/
/obj/
*.user
*.suo
*.sln.docstates
.vs/

# --- Unity 构建产物与编辑器缓存（可重新生成，不入库）---
/_build_demo/
/Myproject/Library/
/Myproject/Temp/
/Myproject/Logs/
/Myproject/UserSettings/
/Myproject/Builds/
/Myproject/obj/
/Myproject/data/
/Myproject/.tmp_synth/
/Myproject/.agents/
*.unitypackage

# --- Unity 播放器 runtime/ 随仓库分发 ---
# 原因：dotnet build 只产出 WPF 的 exe，Unity 播放器需 Unity 2021.3.45f2c1
# 重新出包才能得到；为了保证「clone + 编译」即可运行，播放器必须入库。
# 下面只排除每次运行都会改写的桥接文件与历史记录，不排除可执行本体。
/runtime/_backup_oldplayer/
/runtime/data/PenaltyKickHistory/
/runtime/data/wpf-*.txt
/runtime/data/*.log

# --- Python 字节码缓存（解释器本体入库，缓存不入库）---
# 绝对不要写 *.py[cod]：那会把 *.pyd（Windows 下的 C 扩展，如 cv2.pyd / torch 的
# _C.pyd）一起忽略掉。python_env 必须包含 .pyd，否则 clone 后 import cv2 直接失败。
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.pytest_cache/

# 32 位 polars 运行时：64 位解释器永远不会加载它，且单个 _polars_runtime.pyd 占 176MB。
# 项目代码未 import polars（仅被某个依赖连带装进来），排除不影响运行。
python_env/Lib/site-packages/_polars_runtime_32/

# --- 前端依赖与构建输出 ---
# node_modules 不入库；dist 必须入库：WPF 主界面是 WebView2 加载 dist 的产物，
# clone 后若没有 dist，进程会弹「找不到界面资源目录，请先执行 npm run build」。
# 改动 src/AIfootball.Web 源码后，需重新 npm run build 并提交 dist。
src/AIfootball.Web/node_modules/
src/AIfootball.Web/.vite/

# --- 运行期数据与本地输出 ---
# 注意：data/ 与 calib/ 下有一部分是「跑起来必需」的输入，
# 不能整目录忽略，否则 clone 后检测链路直接不可用。只排除可再生成的大数据集。
/data/external/
/data/goal_detect/
/data/samples/
/data/calib/
/logs/
/output/*
!/output/blender/
/output/blender/*.blend1
/output/blender/preview*/

# --- 打包/发布产物 ---
/dist/
*.msix
*.msixbundle
.build-check/

# --- AI 工具工作目录（会话记录、记忆、缓存，不入库）---
/.workbuddy/
/.codebuddy/

# --- 临时/系统文件 ---
.tmp_*
*.tmp
*.log
Thumbs.db
Desktop.ini
.DS_Store
