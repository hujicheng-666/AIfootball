# ============================================================
# AIfootball .gitignore
# ============================================================

# --- 超过 GitHub 100MB 单文件限制，无法直接推送（需 LFS 或排除）---
python_env/Lib/site-packages/torch/lib/torch_cpu.dll
python_env/Lib/site-packages/_polars_runtime_32/_polars_runtime.pyd

# --- .NET 编译产物 ---
[Bb]in/
[Oo]bj/
*.user
*.suo

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# --- Unity 工程缓存（Myproject/.gitignore 也有覆盖，这里兜底）---
Myproject/Library/
Myproject/Temp/
Myproject/Logs/
Myproject/UserSettings/
Myproject/Builds/

# --- 构建验证/临时产物 ---
.build-check/

# --- 系统/编辑器文件 ---
Thumbs.db
Desktop.ini
.DS_Store
