<UserControl x:Class="AIfootball.App.Views.Pages.ResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="360"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 页面标题 -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="结果查看"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="查看3D轨迹重建与弹道拟合结果"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- 输出目录 -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="📂 输出目录结构" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Border Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="8" Padding="16">
                        <StackPanel TextElement.FontFamily="Consolas" TextElement.FontSize="12">
                            <TextBlock Text="output/" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                            <TextBlock Text="  ├── trajectory_3d/" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Inlines>
                                    <Run Text="      # 3D 重建轨迹 (JSON)" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock.Inlines>
                            </TextBlock>
                            <TextBlock Text="  │   └── &lt;sample&gt;/" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="  ├── trajectory_ballistic/" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Inlines>
                                    <Run Text="  # 弹道拟合结果 (JSON)" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock.Inlines>
                            </TextBlock>
                            <TextBlock Text="  │   └── &lt;sample&gt;/" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="  ├── videos/" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Inlines>
                                    <Run Text="               # 录制的视频" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock.Inlines>
                            </TextBlock>
                            <TextBlock Text="  └── annotated/" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Inlines>
                                    <Run Text="            # 标注帧" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock.Inlines>
                            </TextBlock>
                            <TextBlock Text="data/" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="  ├── *_trajectory.csv" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Inlines>
                                    <Run Text="          # Unity 播放用 CSV" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock.Inlines>
                            </TextBlock>
                            <TextBlock Text="  └── goalkeepers/" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Inlines>
                                    <Run Text="             # 门将方案" Foreground="{StaticResource TextMutedBrush}"/>
                                </TextBlock.Inlines>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 快速打开 -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="🔗 快速操作" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="📁 打开输出目录"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,8" Margin="0,0,12,8"
                                Click="OpenOutputDir_Click"/>
                        <Button Content="🎮 启动 Unity 查看器"
                                Style="{StaticResource SuccessButton}"
                                Padding="16,8" Margin="0,0,12,8"
                                Click="LaunchUnity_Click"/>
                        <Button Content="📊 导出 CSV"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,8" Margin="0,0,12,8"
                                Click="ExportCsv_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
