<UserControl x:Class="AIfootball.App.Views.Pages.ResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIfootball.App.Views.Pages"
             xmlns:controls="clr-namespace:AIfootball.App.Controls"
             PreviewKeyDown="ResultsPage_PreviewKeyDown"
             Background="#18232B">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <!--
                工具栏按「用户在这一页要做的事」分成四组，而不是按代码模块摊平：
                  ① 回放      看这一脚的播放动作（重播 + 速度档位）
                  ② 视角      控制观察机位
                  ③ 门将模型  决定这一脚由谁去扑（配置，不是播放动作）
                  ④ 数据      引入外部弹道 CSV（不参与播放）
                组间用竖线断开，组内用间距聚合；权重靠控件形态区分，不靠文字标签。
            -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ① 回放 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="重新播放" Style="{StaticResource PrimaryButton}"
                            Padding="14,5" FontSize="12" Click="Replay_Click"
                            ToolTip="从第一帧重新播放这一脚"/>
                    <Border Style="{StaticResource SegmentedHost}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="播放速度">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="SpeedSlow" Content="0.5×" Tag="0.5"
                                          Style="{StaticResource SegmentItem}" Click="Speed_Click"/>
                            <ToggleButton x:Name="SpeedNormal" Content="1×" Tag="1" IsChecked="True"
                                          Style="{StaticResource SegmentItem}" Click="Speed_Click"/>
                            <ToggleButton x:Name="SpeedFast" Content="2×" Tag="2"
                                          Style="{StaticResource SegmentItem}" Click="Speed_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ② 视角 -->
                <Border Grid.Column="1" Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="复位视角" Style="{StaticResource SecondaryButton}" Padding="11,4" FontSize="12"
                            Click="Reset_Click" ToolTip="机位回到默认预设"/>
                    <Button Content="切换机位" Style="{StaticResource SecondaryButton}" Padding="11,4" FontSize="12"
                            Margin="6,0,0,0" Click="View_Click" ToolTip="在门将视角 / 侧视 / 俯视之间轮换"/>
                </StackPanel>

                <!-- ③ 门将模型：配置项，紧邻右侧数据区，与播放动作分开 -->
                <Button x:Name="SelectGoalkeeperButton" Grid.Column="4" Style="{StaticResource SecondaryButton}"
                        Padding="11,4" Click="SelectGoalkeeper_Click" ToolTip="选择这一脚由哪位门将模型扑救">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="门将" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="KeeperNameText" Text="未选择" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="7,0,0,0"
                                   MaxWidth="96" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                              Margin="7,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- ④ 数据与分析 -->
                <Border Grid.Column="5" Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                <Button Grid.Column="6" Content="导入轨迹" Style="{StaticResource SecondaryButton}" Padding="11,4" FontSize="12"
                        Click="ImportCsv_Click" ToolTip="导入外部弹道 CSV（教练或第三方系统产出）"/>

                <!-- 渲染端连接状态：常驻但不抢注意力 -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse x:Name="UnityStatusDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="CommandStatusText" Text="渲染端已连接" Margin="6,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <local:UnityHwndHost x:Name="UnityHost"/>
            <Border x:Name="StartupOverlay" Background="#18232B" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock x:Name="OverlayText" Text="正在加载 Unity 渲染端…" Foreground="#E8F1F5" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Popup x:Name="GoalkeeperPopup" PlacementTarget="{Binding ElementName=SelectGoalkeeperButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="720" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Popup 是独立顶层窗口，会浮在模态对话框和训练覆盖层之上，
                         所以必须有一个显式的关闭按钮，不能只靠"点外面"。 -->
                    <Grid Grid.Row="0" Margin="2,0,2,6">
                        <TextBlock Text="选择门将" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}" Padding="9,0" FontSize="11"
                                Click="CloseGoalkeeperPopup_Click" ToolTip="关闭"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                    <ListBox x:Name="GoalkeeperList" Grid.Column="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" MaxHeight="260" DisplayMemberPath="Label">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="MouseEnter" Handler="GoalkeeperItem_MouseEnter"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="GoalkeeperItem_Click"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewName" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewDesc" Grid.Row="1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                            <TextBlock x:Name="PreviewAttrs" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21"/>
                            <controls:RadarChartControl x:Name="PreviewRadar" Grid.Row="3" MinHeight="150"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="10" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewHeatmapTitle" Text="区域弱点分布" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <controls:GoalZoneHeatmapControl x:Name="PreviewHeatmap" Grid.Row="1" MinHeight="118" Margin="0,6,0,0"/>
                            <TextBlock x:Name="PreviewHeatmapLegend" Grid.Row="2" FontSize="10" LineHeight="15"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="冷色：强扑救区　暖色：弱扑救区"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="编辑属性" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="11" Click="EditGoalkeeper_Click"/>
                                <Button Content="另存为" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="11" Margin="6,0,0,0" Click="SaveGoalkeeperAs_Click"/>
                                <Button Content="训练" Style="{StaticResource PrimaryButton}" Padding="10,3" FontSize="11" Margin="6,0,0,0" Click="OpenTrainerPage_Click" ToolTip="转到「门将」页，用比赛片段训练该模型"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

    </Grid>
</UserControl>
