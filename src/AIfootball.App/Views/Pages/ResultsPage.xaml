<UserControl x:Class="AIfootball.App.Views.Pages.ResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIfootball.App.Views.Pages"
             xmlns:controls="clr-namespace:AIfootball.App.Controls"
             Background="#18232B">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid><StackPanel Orientation="Horizontal">
                <Button Content="导入 CSV" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="ImportCsv_Click"/>
                <Button x:Name="ShooterProfileButton" Content="生成点球手特点" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="GenerateShooterProfile_Click"/>
                <Button Content="从头重新播放" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="Replay_Click"/>
                <Button Content="复位" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="Reset_Click"/>
                <Button Content="切换视角" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="View_Click"/>
                <Button x:Name="SelectGoalkeeperButton" Content="门将：未选择" ToolTip="点击切换门将" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="SelectGoalkeeper_Click"/>
                <Button Content="0.5x" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Tag="0.5" Click="Speed_Click"/>
                <Button Content="1x" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Tag="1" Click="Speed_Click"/>
                <Button Content="2x" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Tag="2" Click="Speed_Click"/>
            </StackPanel><TextBlock x:Name="CommandStatusText" Text="Unity 控制台已就绪" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        </Border>
        <Grid Grid.Row="1">
            <local:UnityHwndHost x:Name="UnityHost"/>
            <Border x:Name="StartupOverlay" Background="#18232B" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock x:Name="OverlayText" Text="正在加载 Unity…" Foreground="#E8F1F5" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Popup x:Name="GoalkeeperPopup" PlacementTarget="{Binding ElementName=SelectGoalkeeperButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="470" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="GoalkeeperList" Grid.Column="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" MaxHeight="260" DisplayMemberPath="Label">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <EventSetter Event="MouseEnter" Handler="GoalkeeperItem_MouseEnter"/>
                                <EventSetter Event="MouseLeftButtonUp" Handler="GoalkeeperItem_Click"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PreviewName" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewDesc" Grid.Row="1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                            <TextBlock x:Name="PreviewAttrs" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21"/>
                            <controls:RadarChartControl x:Name="PreviewRadar" Grid.Row="3" MinHeight="150"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
        <Popup x:Name="ShooterProfilePopup" PlacementTarget="{Binding ElementName=ShooterProfileButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Width="500" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="点球手属性" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="ShooterProfileCountText" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        <controls:RadarChartControl x:Name="ShooterProfileRadar" Height="205" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="14" Margin="12,0,0,0">
                        <TextBlock x:Name="ShooterProfileAttrsText" TextWrapping="Wrap" LineHeight="25" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
