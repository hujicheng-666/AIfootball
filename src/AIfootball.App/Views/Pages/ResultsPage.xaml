<UserControl x:Class="AIfootball.App.Views.Pages.ResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIfootball.App.Views.Pages"
             Background="#18232B">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid><StackPanel Orientation="Horizontal">
                <Button Content="导入 CSV" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="ImportCsv_Click"/>
                <Button Content="播放" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="Replay_Click"/>
                <Button Content="复位" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="Reset_Click"/>
                <Button Content="切换视角" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="View_Click"/>
                <Button Content="上一门将" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="PreviousGoalkeeper_Click"/>
                <Button Content="下一门将" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0" Click="NextGoalkeeper_Click"/>
                <Button Content="0.5x" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Tag="0.5" Click="Speed_Click"/>
                <Button Content="1x" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Tag="1" Click="Speed_Click"/>
                <Button Content="2x" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Tag="2" Click="Speed_Click"/>
            </StackPanel><TextBlock x:Name="CommandStatusText" Text="Unity 控制台已就绪" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
        </Border>
        <Grid Grid.Row="1"><local:UnityHwndHost x:Name="UnityHost"/><Border x:Name="StartupOverlay" Background="#18232B" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="180" Height="4"/><TextBlock x:Name="OverlayText" Text="正在加载 Unity…" Foreground="#E8F1F5" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel></Border></Grid>
    </Grid>
</UserControl>
