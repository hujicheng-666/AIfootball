<UserControl x:Class="AIfootball.App.Views.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 页面标题 -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="相机标定"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="双目标定：内参 + 外参"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- 内参标定卡片 -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📐 内参标定" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="使用棋盘格视频计算每台相机的焦距、光心、畸变系数"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <!-- 左棋盘格视频（射手视角左侧） -->
                        <TextBlock Text="📷 射手视角左侧棋盘格视频（左相机）" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LeftChessVideo" Style="{StaticResource ModernTextBox}" FontSize="12" Height="32"/>
                            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="12,4" FontSize="12"
                                    Click="BrowseLeftChess_Click"/>
                        </Grid>

                        <!-- 右棋盘格视频（射手视角右侧） -->
                        <TextBlock Text="📷 射手视角右侧棋盘格视频（右相机）" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RightChessVideo" Style="{StaticResource ModernTextBox}" FontSize="12" Height="32"/>
                            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="12,4" FontSize="12"
                                    Click="BrowseRightChess_Click"/>
                        </Grid>

                        <TextBlock Text="每段视频内多次展示棋盘格（9×6 内角点、23mm 格子）：多角度、远近、倾斜、避免反光，时长 15~30 秒。脚本自动挑选质量好的帧。"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <TextBlock x:Name="IntrinsicsStatus" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Button x:Name="CalibrateIntrinsicsBtn" Content="🔧 开始内参标定"
                                Style="{StaticResource PrimaryButton}" Padding="16,8"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="CalibrateIntrinsics_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 外参标定卡片 -->
            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="🌐 外参标定" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="用左右各一张足球场照片计算两相机相对位姿（点击参考点）"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0"/>

                    <StackPanel Margin="0,16,0,0">
                        <!-- 左球场照片（射门视角左侧） -->
                        <TextBlock Text="📷 射门视角左侧参考照片（左相机）" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LeftFieldImage" Style="{StaticResource ModernTextBox}" FontSize="12" Height="32"/>
                            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="12,4" FontSize="12"
                                    Click="BrowseLeftField_Click"/>
                        </Grid>

                        <!-- 右球场照片（射门视角右侧） -->
                        <TextBlock Text="📷 射门视角右侧参考照片（右相机）" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RightFieldImage" Style="{StaticResource ModernTextBox}" FontSize="12" Height="32"/>
                            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="12,4" FontSize="12"
                                    Click="BrowseRightField_Click"/>
                        </Grid>

                        <TextBlock Text="前提：已完成内参标定。左=射门视角左侧（左相机）、右=射门视角右侧（右相机）。开始后按提示在图像窗口依次点击参考点。"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <TextBlock x:Name="ExtrinsicsStatus" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Button x:Name="CalibrateExtrinsicsBtn" Content="🎯 开始外参标定"
                                Style="{StaticResource SuccessButton}" Padding="20,8"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="CalibrateExtrinsics_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 标定文件状态 -->
            <Border Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="📁 标定文件状态" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="标定结果保存在 calib/ 目录下，供3D重建使用。"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border CornerRadius="6" Padding="10,6"
                                Background="{StaticResource SurfaceAltBrush}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="左内参" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="intrinsics_left.npz" FontSize="11"
                                           FontWeight="SemiBold" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="10,6"
                                Background="{StaticResource SurfaceAltBrush}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="右内参" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="intrinsics_right.npz" FontSize="11"
                                           FontWeight="SemiBold" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="10,6"
                                Background="{StaticResource SurfaceAltBrush}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="左外参" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="left_pose.npz" FontSize="11"
                                           FontWeight="SemiBold" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="10,6"
                                Background="{StaticResource SurfaceAltBrush}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="右外参" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="right_pose.npz" FontSize="11"
                                           FontWeight="SemiBold" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
