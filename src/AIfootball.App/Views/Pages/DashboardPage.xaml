<UserControl x:Class="AIfootball.App.Views.Pages.DashboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:converters="clr-namespace:AIfootball.App.Converters" xmlns:models="clr-namespace:AIfootball.App.Models" xmlns:local="clr-namespace:AIfootball.App.Views.Pages"
 Background="{StaticResource BackgroundBrush}">
 <UserControl.Resources>
  <converters:BoolToVisibilityConverter x:Key="BoolToVis"/><converters:InverseBoolConverter x:Key="InverseBool"/><converters:BoolToColorConverter x:Key="BoolToColor"/><local:LogLevelToBrushConverter x:Key="LogLevelBrush"/>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="36,28,36,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="360"/></Grid.RowDefinitions>
   <TextBlock Text="&#x4EEA;&#x8868;&#x76D8;" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
   <TextBlock Grid.Row="1" Text="&#x7CFB;&#x7EDF;&#x6982;&#x89C8;&#x3001;&#x4EFB;&#x52A1;&#x5165;&#x53E3;&#x4E0E;&#x8FD0;&#x884C;&#x72B6;&#x6001;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,24"/>
   <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,20" MinHeight="196"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Python &#x63A8;&#x7406;&#x73AF;&#x5883;" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Border Grid.Column="1" CornerRadius="12" Padding="10,4" Background="{Binding IsEnvironmentReady, Converter={StaticResource BoolToColor}, ConverterParameter=bg}"><TextBlock FontSize="11" Foreground="White"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEnvironmentReady}" Value="True"><Setter Property="Text" Value="&#x5C31;&#x7EEA;"/></DataTrigger><DataTrigger Binding="{Binding IsEnvironmentReady}" Value="False"><Setter Property="Text" Value="&#x5F85;&#x8BBE;&#x7F6E;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid>
     <TextBlock Grid.Row="1" Text="{Binding EnvStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Visibility="{Binding SetupProgressVisible, Converter={StaticResource BoolToVis}}"><ProgressBar Height="6" Value="{Binding SetupProgress}" Maximum="100" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/><TextBlock Text="{Binding SetupProgress, StringFormat={}{0}%}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="&#x4E00;&#x952E;&#x5B89;&#x88C5;&#x73AF;&#x5883;" Style="{StaticResource PrimaryButton}" Command="{Binding SetupEnvironmentCommand}" Visibility="{Binding IsEnvironmentReady, Converter={StaticResource InverseBool}}" IsEnabled="{Binding IsSettingUp, Converter={StaticResource InverseBool}}"/></Grid>
    </Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" MinHeight="196"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="&#x7CFB;&#x7EDF;&#x6982;&#x89C8;" FontSize="16" FontWeight="SemiBold"/>
     <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="GPU" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding GpuInfo.GpuName, TargetNullValue=&#x68C0;&#x6D4B;&#x4E2D;...}" FontSize="12" FontWeight="SemiBold" MaxWidth="160" TextTrimming="CharacterEllipsis"/></Grid>
     <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#x76F8;&#x673A;&#x6807;&#x5B9A;" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CalibrationStatus.FullyReady}" Value="True"><Setter Property="Text" Value="&#x5DF2;&#x5B8C;&#x6210;"/></DataTrigger><DataTrigger Binding="{Binding CalibrationStatus.FullyReady}" Value="False"><Setter Property="Text" Value="&#x5F85;&#x5B8C;&#x6210;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#x53EF;&#x7528;&#x6837;&#x672C;" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding SampleCount, StringFormat={}{0} &#x4E2A;}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Grid>
    </Grid></Border>
   </Grid>
   <Grid Grid.Row="3" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,20" MinHeight="142" Cursor="Hand" MouseLeftButtonDown="OfflineCard_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="&#x79BB;&#x7EBF;&#x5904;&#x7406;" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="&#x5BFC;&#x5165;&#x5DF2;&#x5F55;&#x5236;&#x6837;&#x672C;&#xFF0C;&#x5B8C;&#x6210; 3D &#x91CD;&#x5EFA;&#x4E0E;&#x8F68;&#x8FF9;&#x62DF;&#x5408;&#x3002;" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/><TextBlock Text="&#x5BFC;&#x5165;&#x89C6;&#x9891;&#x4E0E; CSV" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="&gt;" FontSize="26" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20" MinHeight="142" Cursor="Hand" MouseLeftButtonDown="OnlineCard_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="&#x5728;&#x7EBF;&#x5F55;&#x5236;" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="&#x5B9E;&#x65F6;&#x91C7;&#x96C6;&#x53CC;&#x6444;&#x50CF;&#x5934;&#x753B;&#x9762;&#xFF0C;&#x5E76;&#x81EA;&#x52A8;&#x8FDB;&#x5165;&#x5206;&#x6790;&#x6D41;&#x7A0B;&#x3002;" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/><TextBlock Text="&#x8FDE;&#x63A5;&#x8BBE;&#x5907;&#x540E;&#x5F00;&#x59CB;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="&gt;" FontSize="26" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/></Grid></Border>
   </Grid>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#x8FD0;&#x884C;&#x65E5;&#x5FD7;" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding LogEntries.Count, StringFormat=({0})}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><Button Grid.Column="1" Content="&#x590D;&#x5236;&#x5168;&#x90E8;" FontSize="11" Style="{StaticResource SecondaryButton}" Padding="8,3" Click="CopyLog_Click"/><Button Grid.Column="2" Content="&#x6E05;&#x7A7A;" FontSize="11" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="6,0,0,0" Click="ClearLog_Click"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="LogScrollViewer"><ItemsControl ItemsSource="{Binding LogEntries}" x:Name="LogItemsControl"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:LogEntry}"><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,8,0"/><TextBox Grid.Column="1" Text="{Binding Message, Mode=OneWay}" FontSize="12" FontFamily="Consolas" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#x53EF;&#x7528;&#x6837;&#x672C;" FontSize="16" FontWeight="SemiBold"/><Button Grid.Column="1" Content="&#x5237;&#x65B0;" Style="{StaticResource SecondaryButton}" Padding="10,4" Command="{Binding RefreshCommand}" FontSize="11"/></Grid><ListView Grid.Row="1" ItemsSource="{Binding Samples}" BorderThickness="0" Background="Transparent" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate DataType="{x:Type models:SampleInfo}"><Border Padding="12,9" Margin="0,2" Background="Transparent" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VideoCount, StringFormat={}{0} &#x4E2A;&#x89C6;&#x9891;}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/></StackPanel><Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="8,2" Margin="4,0"><TextBlock Text="&#x4E09;&#x7EF4;" FontSize="10"/></Border><Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="8,2" Margin="4,0"><TextBlock Text="&#x62DF;&#x5408;" FontSize="10"/></Border></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>
