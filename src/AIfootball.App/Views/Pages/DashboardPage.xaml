<UserControl x:Class="AIfootball.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AIfootball.App.Converters"
             xmlns:models="clr-namespace:AIfootball.App.Models"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22,26,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="工作概览" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="环境、数据和分析任务的当前状态" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,18"/>

            <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="推理环境" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="本地 Python 与视觉依赖" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Background="{Binding IsEnvironmentReady, Converter={StaticResource BoolToColor}, ConverterParameter=bg}" Padding="9,4" CornerRadius="5"><TextBlock Foreground="White" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsEnvironmentReady}" Value="True"><Setter Property="Text" Value="已就绪"/></DataTrigger><DataTrigger Binding="{Binding IsEnvironmentReady}" Value="False"><Setter Property="Text" Value="待配置"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></Grid>
                    <TextBlock Grid.Row="1" Text="{Binding EnvStatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,12"/>
                    <StackPanel Grid.Row="2"><ProgressBar Height="6" Maximum="100" Value="{Binding SetupProgress}" Visibility="{Binding SetupProgressVisible, Converter={StaticResource BoolToVis}}"/><Button Content="配置本地环境" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding SetupEnvironmentCommand}" Visibility="{Binding IsEnvironmentReady, Converter={StaticResource InverseBool}}" IsEnabled="{Binding IsSettingUp, Converter={StaticResource InverseBool}}"/></StackPanel>
                </Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="资源状态" FontWeight="SemiBold" FontSize="15"/><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding GpuInfo.GpuName, TargetNullValue=检测中}" FontSize="11" FontWeight="SemiBold" MaxWidth="150" TextTrimming="CharacterEllipsis"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="相机标定" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CalibrationStatus.FullyReady}" Value="True"><Setter Property="Text" Value="可用"/></DataTrigger><DataTrigger Binding="{Binding CalibrationStatus.FullyReady}" Value="False"><Setter Property="Text" Value="待完成"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="数据样本" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding SampleCount, StringFormat={}{0} 个}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/></Grid></Grid></Grid></Border>
            </Grid>

            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="任务入口" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Cursor="Hand" MouseLeftButtonDown="OfflineCard_Click"><Grid Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="离线样本处理" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="三维重建、弹道拟合与 Unity 导出。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="22" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/></Grid></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Cursor="Hand" MouseLeftButtonDown="OnlineCard_Click"><Grid Margin="18,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="在线采集" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="双路相机采集与实时分析。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="22" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/></Grid></Border></Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="分析链路" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PipelineStatusText}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PipelineMaterial" Opacity="0.48">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#E2EEFF" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="#1769D1" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="素材" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                                    <TextBlock Text="视频与 CSV" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="PipelineArrow1" Grid.Column="1" Text="›" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="PipelineReconstruct" Grid.Column="2" Opacity="0.48">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#E4F7F0" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="#158463" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="重建" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                                    <TextBlock Text="空间轨迹" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="PipelineArrow2" Grid.Column="3" Text="›" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="PipelineFit" Grid.Column="4" Opacity="0.48">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#FFF3D9" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="#B26A00" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="拟合" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                                    <TextBlock Text="落点预测" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="PipelineArrow3" Grid.Column="5" Text="›" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="PipelineDelivery" Grid.Column="6" Opacity="0.48">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#EEF1F5" HorizontalAlignment="Left"><TextBlock Text="4" Foreground="#596577" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="交付" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                                    <TextBlock Text="Unity / CSV" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="2" MinWidth="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="可用样本" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" HorizontalAlignment="Stretch"><ListView ItemsSource="{Binding Samples}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate DataType="{x:Type models:SampleInfo}"><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel MinWidth="0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VideoCount, StringFormat={}{0} 个视频}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="就绪" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
