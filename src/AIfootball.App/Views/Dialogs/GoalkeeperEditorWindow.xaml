<Window x:Class="AIfootball.App.Views.Dialogs.GoalkeeperEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑门将属性" Width="600" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.32"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="门将属性" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            HorizontalAlignment="Right" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="18,14,18,0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="名称" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Margin="0,5,0,0"/>
                    <TextBlock Text="改掉名称即另存为新门将，原名文件不受影响。"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/>

                    <TextBlock Text="显示名称" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0"/>
                    <TextBox x:Name="DisplayNameBox" Style="{StaticResource ModernTextBox}" Margin="0,5,0,0"/>

                    <TextBlock Text="描述" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0"/>
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource ModernTextBox}"
                             Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"/>

                    <TextBlock Text="基础属性" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                    <Grid x:Name="AttributeGrid" Margin="0,8,0,0"/>

                    <TextBlock Text="区域扑救概率" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,0"/>
                    <TextBlock Text="取值 0–1。Unity 回放按这张表判定扑救，改完立刻生效。"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    <Grid x:Name="ZoneGrid" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="0,0,8,8"
                    Padding="18,12" Margin="0,16,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Width="360" HorizontalAlignment="Left"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                MinWidth="80" Click="Cancel_Click"/>
                        <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                MinWidth="80" Margin="8,0,0,0" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
