<Window x:Class="AIfootball.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:pages="clr-namespace:AIfootball.App.Views.Pages"
        xmlns:web="clr-namespace:AIfootball.App.Views.Web"
        Title="AIfootball | Match Analysis"
        Height="760" Width="1240" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}">
    <!-- 不能再用分层窗口（AllowsTransparency=True）：WPF 的 MediaElement 和 HwndHost
         在分层窗口里无法渲染，训练用的视频会永远黑屏。改用 WindowChrome 补回边框缩放。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" ClipToBounds="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource ChromeElevatedBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,1,0" Padding="18,0">
                    <Image Source="/Resources/SpotIQMark.png" Width="38" Height="27" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <TextBlock Text="MATCH ANALYSIS DESK" Foreground="{StaticResource ChromeMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <Border Width="1" Height="14" Background="{StaticResource ChromeBorderBrush}" Margin="12,0"/>
                    <TextBlock x:Name="TitleBarText" Text="工作台" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource TitleBarButton}" Click="MaxRestore_Click" ToolTip="最大化"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButton}" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="12,18">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <!-- 按"每次干活的顺序"分组，而不是按代码模块分。
                                 低频动作（标定/环境/门将库）收进"配置"，不与主流程平级。 -->
                            <TextBlock Text="分析流程" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,8"/>
                            <RadioButton x:Name="NavWorkbench" Style="{StaticResource NavRadioButton}" Content="工作台" Tag="workbench" IsChecked="True" Checked="NavItem_Checked"/>
                            <RadioButton x:Name="NavCapture" Style="{StaticResource NavRadioButton}" Content="采集" Tag="capture" Checked="NavItem_Checked"/>
                            <RadioButton x:Name="NavAnalyze" Style="{StaticResource NavRadioButton}" Content="分析" Tag="analyze" Checked="NavItem_Checked"/>
                            <RadioButton x:Name="NavReview" Style="{StaticResource NavRadioButton}" Content="回放" Tag="review" Checked="NavItem_Checked"/>

                            <TextBlock Text="系统配置" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,18,0,8"/>
                            <RadioButton x:Name="NavKeeper" Style="{StaticResource NavRadioButton}" Content="门将" Tag="keeper" Checked="NavItem_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadioButton}" Content="设置" Tag="settings" Checked="NavItem_Checked"/>
                        </StackPanel>
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="运行环境" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="EnvStatusDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/><TextBlock x:Name="EnvStatusLabel" Text="正在检查" FontSize="12" Margin="8,0,0,0"/></StackPanel>
                                <TextBlock Text="VERSION 2.0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>
                <Grid Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                    <!-- 概览页已迁到 WebView2（React）。其余三页仍由 WPF 渲染，
                         切换时必须确保二者不同时可见：WebView2 是独立 HWND，
                         与 HwndHost / MediaElement 重叠会出现层级撕裂。 -->
                    <web:WebHost x:Name="WebHome" Visibility="Visible"/>
                    <pages:DashboardPage x:Name="DashboardPage" Visibility="Collapsed"/>
                    <pages:PipelinePage x:Name="PipelinePage" Visibility="Collapsed"/>
                    <pages:CalibrationPage x:Name="CalibrationPage" Visibility="Collapsed"/>
                    <pages:ResultsPage x:Name="ResultsPage" Visibility="Collapsed"/>
                    <pages:GoalkeeperPage x:Name="GoalkeeperPage" Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" ClipToBounds="True">
                <Grid Margin="18,0"><TextBlock x:Name="StatusBarTextBlock" Text="就绪" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock x:Name="GpuLabel" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            </Border>
        </Grid>
    </Border>
</Window>
