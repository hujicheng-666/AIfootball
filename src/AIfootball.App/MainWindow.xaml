<Window x:Class="AIfootball.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:AIfootball.App.Views.Pages"
        mc:Ignorable="d"
        Title="AIfootball — AI 足球轨迹分析平台"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <Window.Resources>
        <!-- 导航项目 -->
        <x:Array x:Key="NavItems" Type="{x:Type pages:NavItem}">
            <pages:NavItem Icon="🏠" Title="仪表盘" PageKey="dashboard"/>
            <pages:NavItem Icon="⚙" Title="流水线" PageKey="pipeline"/>
            <pages:NavItem Icon="🔧" Title="标定" PageKey="calibration"/>
            <pages:NavItem Icon="📊" Title="结果" PageKey="results"/>
        </x:Array>
    </Window.Resources>

    <!-- 窗口主体 — 圆角+阴影 -->
    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="#A0000000" BlurRadius="28" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 自定义标题栏 -->
                <RowDefinition Height="36"/>
                <!-- 内容区域 -->
                <RowDefinition Height="*"/>
                <!-- 状态栏 -->
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ============== 标题栏 ============== -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo 区域 -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="0,0,0,2"
                        CornerRadius="6,0,0,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0">
                        <TextBlock Text="⚽" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text=" AIfootball"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 标题区域 -->
                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock x:Name="TitleBarText"
                               Text="AI 足球轨迹分析平台"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               FontSize="12"/>
                </Border>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Style="{StaticResource TitleBarButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化"/>
                    <Button x:Name="MaxRestoreBtn"
                            Content="□" Style="{StaticResource TitleBarButton}"
                            Click="MaxRestore_Click"
                            ToolTip="最大化"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}"
                            Click="Close_Click"
                            ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- ============== 主内容 ============== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 侧边导航 -->
                    <ColumnDefinition Width="220"/>
                    <!-- 分隔线 -->
                    <ColumnDefinition Width="1"/>
                    <!-- 页面内容 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧边导航栏 -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}">
                    <StackPanel Margin="0,12,0,0">
                        <!-- 导航按钮 -->
                        <RadioButton x:Name="NavDashboard"
                                     Style="{StaticResource NavRadioButton}"
                                     Content="🏠  仪表盘"
                                     Tag="dashboard"
                                     IsChecked="True"
                                     Checked="NavItem_Checked"
                                     Margin="8,2"/>
                        <RadioButton x:Name="NavPipeline"
                                     Style="{StaticResource NavRadioButton}"
                                     Content="⚙  流水线处理"
                                     Tag="pipeline"
                                     Checked="NavItem_Checked"
                                     Margin="8,2"/>
                        <RadioButton x:Name="NavCalibration"
                                     Style="{StaticResource NavRadioButton}"
                                     Content="🔧  相机标定"
                                     Tag="calibration"
                                     Checked="NavItem_Checked"
                                     Margin="8,2"/>
                        <RadioButton x:Name="NavResults"
                                     Style="{StaticResource NavRadioButton}"
                                     Content="📊  结果查看"
                                     Tag="results"
                                     Checked="NavItem_Checked"
                                     Margin="8,2"/>

                        <!-- 分割线 -->
                        <Separator Margin="16,16,16,12" Opacity="0.3"/>

                        <!-- 环境状态指示器 -->
                        <Border Margin="12,0" Padding="12"
                                CornerRadius="8"
                                Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="环境状态" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse x:Name="EnvStatusDot"
                                             Width="8" Height="8"
                                             Fill="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EnvStatusLabel"
                                               Text="检查中..."
                                               FontSize="12"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 版本信息 -->
                        <TextBlock Text="v2.0.0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                <!-- 页面容器 -->
                <Grid Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                    <!-- 仪表盘页面 -->
                    <pages:DashboardPage x:Name="DashboardPage"
                                         Visibility="Visible"/>

                    <!-- 流水线页面 -->
                    <pages:PipelinePage x:Name="PipelinePage"
                                        Visibility="Collapsed"/>

                    <!-- 标定页面 -->
                    <pages:CalibrationPage x:Name="CalibrationPage"
                                           Visibility="Collapsed"/>

                    <!-- 结果页面 -->
                    <pages:ResultsPage x:Name="ResultsPage"
                                       Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- ============== 状态栏 ============== -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <TextBlock x:Name="StatusBarTextBlock"
                               Text="就绪"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuLabel"
                               Text=""
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
