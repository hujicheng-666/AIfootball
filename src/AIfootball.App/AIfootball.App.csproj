<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AIfootball</AssemblyName>
    <RootNamespace>AIfootball.App</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>AIfootball Team</Authors>
    <Description>AI 足球轨迹分析平台</Description>
    <ApplicationIcon>..\..\assets\icons\AIfootball.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <SelfContained>false</SelfContained>
    <!-- 只保留中文本地化资源，避免打包 es/fr/de 等卫星程序集目录 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- MSIX 打包 (可选, 需 Windows 10 SDK) -->
    <!-- 发布 MSIX: dotnet publish -c Release -p:EnableMsixTooling=true -->
    <EnableMsixTooling Condition="'$(EnableMsixTooling)' == ''">false</EnableMsixTooling>
    <WindowsPackageType>Msix</WindowsPackageType>
    <ApplicationTitle>AIfootball</ApplicationTitle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <PublisherDisplayName>AIfootball</PublisherDisplayName>
  </PropertyGroup>

  <!-- MSIX 清单 -->
  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>

  <!-- 领域层：门将扑救建模、进度解析、工作区路径真相 -->
  <ItemGroup>
    <ProjectReference Include="..\AIfootball.Core\AIfootball.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\**" />
    <Resource Include="Resources\SpotIQLogoTransparent.png" />
    <Resource Include="Resources\SpotIQMark.png" />
  </ItemGroup>

  <!--
    React 界面产物。改动 src/AIfootball.Web 之后必须先执行：
        cd src/AIfootball.Web && npm run build
    这里不用 <Content Include="dist/**">：那样文件列表在编译开始时求值，
    而 vite 每次 build 都会换文件名，会和 dotnet build 抢文件。
    改成 Build 之后用 Copy 任务实时枚举，谁先谁后都不会失败。
  -->
  <Target Name="CopyWebUi" AfterTargets="Build" Condition="Exists('..\AIfootball.Web\dist')">
    <ItemGroup>
      <WebUiFile Include="..\AIfootball.Web\dist\**\*" />
    </ItemGroup>
    <!-- vite 每次构建都换 hash 文件名，先清掉旧的，否则历史版本会一直堆在安装包里 -->
    <RemoveDir Directories="$(OutDir)web" Condition="Exists('$(OutDir)web')" />
    <Copy SourceFiles="@(WebUiFile)"
          DestinationFiles="@(WebUiFile->'$(OutDir)web\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CheckWebUi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\AIfootball.Web\dist\index.html')"
           Text="Web UI is missing. Restore src/AIfootball.Web/dist or run npm ci and npm run build in src/AIfootball.Web." />
  </Target>

  <Target Name="PublishWebUi" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <PublishedWebUi Include="..\AIfootball.Web\dist\**\*" />
      <ResolvedFileToPublish Include="@(PublishedWebUi)">
        <RelativePath>web\%(PublishedWebUi.RecursiveDir)%(PublishedWebUi.Filename)%(PublishedWebUi.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- 嵌入 Python 引擎到输出目录 -->
  <ItemGroup>
    <Content Include="..\AIfootball.Engine\aifootball\**\*" Exclude="..\AIfootball.Engine\aifootball\**\__pycache__\**" Link="python_engine\aifootball\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\AIfootball.Engine\requirements.txt" Link="python_engine\requirements.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
