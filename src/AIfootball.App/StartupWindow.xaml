<Window x:Class="AIfootball.App.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIfootball.App"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        Topmost="True"
        Background="#050B14"
        AllowsTransparency="True"
        MouseLeftButtonUp="StartupWindow_MouseLeftButtonUp">
    <Window.Resources>
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,42,42" ViewportUnits="Absolute" Viewbox="0,0,42,42" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#050B14">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,42,42"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#123241" Thickness="1"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="42,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,42"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border CornerRadius="6" ClipToBounds="True" Background="#050B14">
        <Grid x:Name="StartupRoot" ClipToBounds="True" SizeChanged="StartupRoot_SizeChanged">
            <Canvas x:Name="SceneCanvas" Width="1600" Height="900" Background="{StaticResource GridBrush}" RenderTransformOrigin="0,0">
                <Rectangle Width="1600" Height="900">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.72,0.42" GradientOrigin="0.72,0.42" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="#100D1E29" Offset="0"/>
                            <GradientStop Color="#B8050B14" Offset="0.58"/>
                            <GradientStop Color="#E8050911" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="530" Canvas.Top="-410" Width="1150" Height="1150" Stroke="#173D4D" StrokeThickness="2" Opacity="0.65"/>
                <Ellipse Canvas.Left="665" Canvas.Top="-275" Width="880" Height="880" Stroke="#0D2734" StrokeThickness="1" Opacity="0.8"/>

                <Image Source="/Resources/SpotIQMark.png" Canvas.Left="110" Canvas.Top="42" Width="170" Height="106" Stretch="Uniform"/>

                <Path Data="M 0,710 L 1600,620" Stroke="#164858" StrokeThickness="2" Opacity="0.7"/>
                <Path Data="M 40,765 L 1560,665" Stroke="#0B5D70" StrokeThickness="1" StrokeDashArray="3 8" Opacity="0.8"/>
                <Path Data="M 130,770 L 1120,490" Stroke="#168CA2" StrokeThickness="2" Opacity="0.52"/>
                <Path Data="M 1210,900 L 1375,640" Stroke="#168CA2" StrokeThickness="1" Opacity="0.35"/>

                <Canvas x:Name="GoalScene" Canvas.Left="650" Canvas.Top="135" Width="860" Height="440" Opacity="0">
                    <Canvas.RenderTransform>
                        <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                    </Canvas.RenderTransform>
                    <Path Data="M 62,72 L 856,8 L 858,328 L 76,356 Z" Fill="#26091924" Stroke="#2B778A" StrokeThickness="1.5"/>
                    <Path Data="M 18,100 L 62,72 M 832,24 L 856,8 M 840,352 L 858,328 M 28,382 L 76,356" Stroke="#4BAFC0" StrokeThickness="2" Opacity="0.8"/>
                    <Path Data="M 18,100 L 832,24 L 840,352 L 28,382 Z" Fill="#70101F2A" Stroke="#B7F4FF" StrokeThickness="3"/>
                    <Path Data="M 46,124 L 804,54 L 812,330 L 54,357 Z" Fill="Transparent" Stroke="#255566" StrokeThickness="1"/>
                    <Path Data="M 198,110 L 204,365 M 368,94 L 374,349 M 538,78 L 544,333 M 708,62 L 714,317" Stroke="#194655" StrokeThickness="1"/>
                    <Path Data="M 44,180 L 806,113 M 46,238 L 808,173 M 50,298 L 810,235" Stroke="#194655" StrokeThickness="1"/>
                    <Path Data="M 18,100 L 832,24 L 840,352 L 28,382 Z" Stroke="#9FEFFC" StrokeThickness="3" Fill="Transparent"/>
                    <Path Data="M 28,382 L 840,352" Stroke="#39D7EA" StrokeThickness="2"/>
                    <TextBlock Canvas.Left="420" Canvas.Top="-18" Text="+Z" Foreground="#9DEFFC" FontFamily="Consolas" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Canvas.Left="846" Canvas.Top="310" Text="+X" Foreground="#9DEFFC" FontFamily="Consolas" FontWeight="Bold" FontSize="16"/>

                    <Canvas x:Name="Keeper" Canvas.Left="400" Canvas.Top="108" Width="160" Height="205" RenderTransformOrigin="0.5,0.7" Visibility="Collapsed">
                        <Canvas.Effect><DropShadowEffect Color="#35DCEC" BlurRadius="18" ShadowDepth="0" Opacity="0.72"/></Canvas.Effect>
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="KeeperRotate" Angle="0"/>
                                <TranslateTransform x:Name="KeeperShift" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="58" Canvas.Top="0" Width="42" Height="46" Fill="#0B2530" Stroke="#C4F7FF" StrokeThickness="2"/>
                        <Path Data="M 55,50 L 102,50 L 124,118 L 26,118 Z" Fill="#167D8D" Stroke="#B4F6FF" StrokeThickness="2"/>
                        <Path Data="M 55,50 L 79,28 L 102,50 L 124,118 L 78,100 L 26,118 Z" Fill="#58C9D6" Opacity="0.5"/>
                        <Canvas x:Name="KeeperLeftArm" Width="160" Height="205" RenderTransformOrigin="0.5,0.18">
                            <Canvas.RenderTransform><RotateTransform x:Name="KeeperLeftArmRotate"/></Canvas.RenderTransform>
                            <Path Data="M 26,64 L 3,118 L 30,135 L 61,77 Z" Fill="#80E5F0" Stroke="#C4F7FF" StrokeThickness="1.5"/>
                        </Canvas>
                        <Canvas x:Name="KeeperRightArm" Width="160" Height="205" RenderTransformOrigin="0.5,0.18">
                            <Canvas.RenderTransform><RotateTransform x:Name="KeeperRightArmRotate"/></Canvas.RenderTransform>
                            <Path Data="M 106,63 L 147,105 L 130,132 L 83,76 Z" Fill="#80E5F0" Stroke="#C4F7FF" StrokeThickness="1.5"/>
                        </Canvas>
                        <Path Data="M 48,116 L 25,190 L 55,194 L 76,123 Z" Fill="#61CBD9" Stroke="#B4F6FF" StrokeThickness="1.5"/>
                        <Path Data="M 95,116 L 112,191 L 141,185 L 116,114 Z" Fill="#61CBD9" Stroke="#B4F6FF" StrokeThickness="1.5"/>
                        <Ellipse Canvas.Left="21" Canvas.Top="186" Width="38" Height="12" Fill="#85EDF7"/>
                        <Ellipse Canvas.Left="107" Canvas.Top="184" Width="38" Height="12" Fill="#85EDF7"/>
                        <Ellipse Canvas.Left="1" Canvas.Top="112" Width="10" Height="10" Fill="#E4FCFF"/>
                        <Ellipse Canvas.Left="143" Canvas.Top="100" Width="10" Height="10" Fill="#E4FCFF"/>
                    </Canvas>
                    <local:PenaltyKeeperControl x:Name="AnimatedKeeper" Canvas.Left="285" Canvas.Top="165" Width="310" Height="225" IsHitTestVisible="False">
                        <local:PenaltyKeeperControl.Effect><DropShadowEffect Color="#32E9FA" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/></local:PenaltyKeeperControl.Effect>
                    </local:PenaltyKeeperControl>
                    <Viewport3D x:Name="KeeperViewport" Canvas.Left="370" Canvas.Top="68" Width="405" Height="310" IsHitTestVisible="False" Visibility="Collapsed">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,1.45,7" LookDirection="0,-0.1,-7" UpDirection="0,1,0" FieldOfView="38"/>
                        </Viewport3D.Camera>
                    </Viewport3D>
                </Canvas>

                <!-- The live path geometry is populated from the ball's rendered position in StartupWindow. -->
                <Path x:Name="FlightPath" Stroke="#36D7EA" StrokeThickness="2" StrokeDashArray="4 9" Opacity="0"/>
                <Canvas x:Name="ParticleTrail" Opacity="0">
                    <Canvas.RenderTransform><TranslateTransform x:Name="ParticleShift"/></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="670" Canvas.Top="628" Width="10" Height="10" Fill="#4DD6E8" Opacity="0.18"/>
                    <Ellipse Canvas.Left="720" Canvas.Top="610" Width="16" Height="16" Fill="#61E3F2" Opacity="0.22"/>
                    <Ellipse Canvas.Left="770" Canvas.Top="584" Width="11" Height="11" Fill="#61E3F2" Opacity="0.24"/>
                    <Ellipse Canvas.Left="820" Canvas.Top="550" Width="20" Height="20" Fill="#4DD6E8" Opacity="0.22"/>
                    <Ellipse Canvas.Left="870" Canvas.Top="515" Width="12" Height="12" Fill="#93F0FB" Opacity="0.3"/>
                    <Ellipse Canvas.Left="920" Canvas.Top="475" Width="18" Height="18" Fill="#4DD6E8" Opacity="0.26"/>
                    <Ellipse Canvas.Left="975" Canvas.Top="425" Width="13" Height="13" Fill="#8DECF8" Opacity="0.32"/>
                    <Ellipse Canvas.Left="1030" Canvas.Top="372" Width="22" Height="22" Fill="#4DD6E8" Opacity="0.28"/>
                    <Ellipse Canvas.Left="1090" Canvas.Top="325" Width="14" Height="14" Fill="#8DECF8" Opacity="0.35"/>
                    <Ellipse Canvas.Left="1150" Canvas.Top="285" Width="18" Height="18" Fill="#4DD6E8" Opacity="0.32"/>
                    <Ellipse Canvas.Left="1210" Canvas.Top="250" Width="11" Height="11" Fill="#B7F4FF" Opacity="0.45"/>
                    <Ellipse Canvas.Left="1270" Canvas.Top="222" Width="16" Height="16" Fill="#4DD6E8" Opacity="0.42"/>
                    <Ellipse Canvas.Left="1335" Canvas.Top="198" Width="11" Height="11" Fill="#B7F4FF" Opacity="0.56"/>
                </Canvas>
                <Ellipse x:Name="BallGlow" Canvas.Left="585" Canvas.Top="635" Width="42" Height="42" Fill="#77E6F4" Opacity="0">
                    <Ellipse.Effect><DropShadowEffect Color="#69F2FF" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="Ball" Canvas.Left="591" Canvas.Top="641" Width="30" Height="30" Fill="#ECFBFF" Stroke="#8DECF8" StrokeThickness="2" Opacity="0"/>

                <StackPanel x:Name="IntroCopy" Canvas.Left="110" Canvas.Top="250" Width="560" Opacity="0">
                    <TextBlock Text="AR x AI" Foreground="#49D7EB" FontFamily="Consolas" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="&#x70B9;&#x7403;&#x8BAD;&#x7EC3;&#x7CFB;&#x7EDF;" Foreground="#F4FBFF" FontFamily="Microsoft YaHei UI" FontWeight="SemiBold" FontSize="78" Margin="0,34,0,16"/>
                    <TextBlock Text="AR x AI PENALTY TRAINING" Foreground="#C8D8E2" FontFamily="Consolas" FontSize="22"/>
                    <TextBlock Text="&#x4EE5;&#x66F4;&#x81EA;&#x7136;&#x7684;&#x5224;&#x65AD;&#xFF0C;&#x8FDB;&#x5165;&#x4E0B;&#x4E00;&#x6B21;&#x5C04;&#x95E8;&#x3002;" Foreground="#94AAB7" FontSize="24" Margin="0,32,0,0"/>
                </StackPanel>
                <StackPanel x:Name="StartupActions" Canvas.Left="110" Canvas.Top="600" Orientation="Horizontal" Opacity="0" Visibility="Collapsed">
                    <Border Width="226" Height="72" Background="#26475A" BorderBrush="#9EEFFC" BorderThickness="2" CornerRadius="38" Margin="0,0,16,0">
                        <TextBlock Text="&#x9879;&#x76EE;&#x8BE6;&#x60C5;    -&gt;" Foreground="#F4FBFF" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Width="226" Height="72" Background="#1D2B37" BorderBrush="#607B88" BorderThickness="1" CornerRadius="38">
                        <TextBlock Text="&#x8FDB;&#x5165;&#x8BAD;&#x7EC3;    -&gt;" Foreground="#F4FBFF" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Border x:Name="Telemetry" Canvas.Left="1080" Canvas.Top="690" Width="250" Padding="20" Background="#C910202C" BorderBrush="#245567" BorderThickness="1" CornerRadius="14" Opacity="0">
                    <StackPanel>
                        <TextBlock Text="GOAL LINE / O" Foreground="#7FABB9" FontFamily="Consolas" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="CoordinateX" Text="X      +0.000 m" Foreground="#C3F3FA" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Margin="0,18,0,8"/>
                        <TextBlock x:Name="CoordinateY" Text="Y      11.000 m" Foreground="#C3F3FA" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CoordinateZ" Text="Z      0.100 m" Foreground="#C3F3FA" FontFamily="Consolas" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Footer" Canvas.Left="110" Canvas.Top="838" Text="PRECISE STRIKE   *   NATURAL RESPONSE" Foreground="#718A98" FontFamily="Consolas" FontWeight="Bold" FontSize="15" Opacity="0"/>
                <TextBlock x:Name="SkipHint" Canvas.Left="690" Canvas.Top="842" Text="CLICK TO ENTER" Foreground="#4C7484" FontFamily="Consolas" FontSize="12" Opacity="0"/>
            </Canvas>
        </Grid>
    </Border>
</Window>
